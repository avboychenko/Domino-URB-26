        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGenerator"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Оцінка економічних втрат (валюта): оцінка грошових збитків, понесених під час цього стану (наприклад, втрата продуктивності, витрати на ремонт).</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#float"></rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#HasCoordinates -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#HasCoordinates">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event_attribute"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CI"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGenerator"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>Точні географічні координати (широта/ довгота), де знаходиться центр стану події.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#HasDuration -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#HasDuration">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event_attribute"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CI"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGenerator"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <rdfs:comment>тривалість події  (TimeInterval/Duration): час, що минув, протягом якого подія перебувала в цьому конкретному стані. Тривала тривалість у критичному стані може посилити каскад.</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime"></rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#HasEventID -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#HasEventID">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CasFailureEvent"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CI"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#DamageEvent"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#LPI_DisruptionEvent"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGenerator"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>Унікальний ідентифікатор каскадної події.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#HasStartTime -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#HasStartTime">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event_attribute"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CI"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#DamageEvent"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#LPI_DisruptionEvent"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGenerator"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WarStrickOnPG"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WarStrickOnPLI"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WarStrickOnWI"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#War_Strick"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Точний момент, коли подія (або конкретний стан) була вперше виявлена ​​або ініційована</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime"></rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#HasTimeInterval -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#HasTimeInterval">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event_attribute"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CI"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGenerator"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Час, необхідний для того, щоб цей стан події запустив наступний стан або подію в каскаді. Це допомагає моделювати швидкість відмови.</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime"></rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_Level -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_Level">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_Properties"/>
        <rdfs:comment>Стандартизована міра величини події 
Minor (1), Moderate (2), Severe (3), Catastrophic (4)
Незначна (1), Помірна (2), Серйозна (3), Катастрофічна (4)</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_Properties -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_Properties">
        <rdfs:comment>Це найважливіші параметри для прийняття рішень, кількісної оцінки впливу події на інфраструктуру та населення.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Origin_System -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Origin_System">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CasFailureEvent"/>
        <rdfs:comment>Інфраструктура, де починається збій</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Propagation_Path -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Propagation_Path">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CasFailureEvent"/>
        <rdfs:comment>Послідовність уражених інфраструктур
Power → Water → Logistics/Port</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Severity_Level -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Severity_Level">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_Properties"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:comment>Рівень серйозності (Enum/Integer): Стандартизована міра величини події (наприклад, Незначний (1), Помірний (2), Важкий (3), Катастрофічний (4))</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"></rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Status_Comp_CI -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Status_Comp_CI">
        <rdfs:comment>Статус компонента КІ</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Temporal_Dynamics -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Temporal_Dynamics">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CasFailureEvent"/>
        <rdfs:comment>Час початку каскадного ефекту, часові рамки ескалації, тривалість відновлення
Outage begins at 10:00, water fails at 10:15</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_attribute -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_attribute">
        <rdfs:comment>Основні властивості</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Trigger_Cause -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Trigger_Cause">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CasFailureEvent"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CI"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#DamageEvent"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#LPI_DisruptionEvent"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGenerator"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WarStrickOnPG"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WarStrickOnPLI"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WarStrickOnWI"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#War_Strick"/>
        <rdfs:comment>Першопричина порушення - тригерна подія, яка спричиняє каскадний ефект
Cyberattack, hardware fault, cloud outage
вказує на причина-наслідковий звязок</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WaterQualityIndex -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WaterQualityIndex">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Atributies_CI"/>
        <rdfs:comment>індекс якості води (за санітарними нормами).</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#What_is_Happening -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#What_is_Happening"/>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#capacityM3 -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#capacityM3">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Atributies_CI"/>
        <rdfs:comment>пропускна здатність у кубічних метрах води.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#capacityMW -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#capacityMW">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Atributies_CI"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CI"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#FiltrSystem"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGenerator"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerLine"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerSubstation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Transformer"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Water_Infrastructure"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#voltageLevel"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:comment>номінальна потужність у мегаватах.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#changesStateOf -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#changesStateOf">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Status_Comp_CI"/>
        <rdfs:comment>фіксує зміну стану компонента в результаті  події</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#currentPhase -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#currentPhase">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event_Status"/>
        <rdfs:comment>Поточна фаза події (наприклад, Ініціація, Поширення, Стабілізація, Відновлення).
Initiation, Propagation, Stabilization, Recovery</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#dependsOnEvent -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#dependsOnEvent">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event_attribute"/>
        <rdfs:comment>залежіть  від іншої події</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#hasProbability -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#hasProbability">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_attribute"/>
        <rdfs:comment>імовірність реалізації загрози</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#hasSource -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#hasSource">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_attribute"/>
        <rdfs:comment>джерело загрози</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#hasThreatType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#hasThreatType">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_attribute"/>
        <rdfs:comment>тип загрози</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#mayTrigger -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#mayTrigger">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_attribute"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CI"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGenerator"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WarStrickOnPG"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WarStrickOnPLI"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WarStrickOnWI"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#War_Strick"/>
        <rdfs:comment>тригерна подія, яка  може ініціювати загрозу</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#operationalStatus -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#operationalStatus">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Atributies_CI"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CI"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGenerator"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerLine"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerSubstation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Transformer"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#voltageLevel"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:comment>стан роботи (активна, резервна, пошкоджена).</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#requiredResources -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#requiredResources">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_Properties"/>
        <rdfs:comment>Список ресурсів, необхідних для пом&apos;якшення цього стану (наприклад, [{&quot;type&quot;: &quot;RepairCrew&quot;, &quot;count&quot;: 5}, {&quot;type&quot;: &quot;Generator&quot;, &quot;count&quot;: 2}]).</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#targets_attack -->

