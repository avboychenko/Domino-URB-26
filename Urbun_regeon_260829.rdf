        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WarStrickOnPG"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WarStrickOnPLI"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WarStrickOnWI"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#War_Strick"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WaterTreatmentPlant"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Water_Infrastructure"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#voltageLevel"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:comment>об’єкт, на який спрямована загроза</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#throughputCapacity -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#throughputCapacity">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Atributies_CI"/>
        <rdfs:comment>Максимальна пропускна здатність (наприклад, кількість контейнерів на годину для &lt;ContainerTerminals&gt; або кількість оброблених суден).</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#trigger_event -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#trigger_event">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event_Status"/>
        <rdfs:comment>початкова подія або умова, яка викликала цей стан, що є вирішальним для визначення причинно-наслідкового зв&apos;язку в каскадному ланцюжку.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#voltageLevel -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#voltageLevel">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Atributies_CI"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CI"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#FiltrSystem"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGenerator"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerLine"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerSubstation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Transformer"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Water_Infrastructure"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#voltageLevel"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:comment>рівень напруги (наприклад, 110 кВ, 330 кВ)</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnContSysWI -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnContSysWI">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_WI"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#TechnogenicThreat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:comment>Атака на SCADA систем, що керують насосними станціями або фільтраційними системами.
Зміна параметрів роботи насосів, що призводить до переповнення або нестачі води.
Атаки на системи моніторингу якості води (наприклад, підробка даних про хімічний склад).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnContainerTerminals -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnContainerTerminals">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_LPI"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#TechnogenicThreat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:comment>Вимкнення систем відстеження контейнерів, що призводить до втрати або крадіжки вантажів</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnFiltrationSystem -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnFiltrationSystem">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_WI"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#TechnogenicThreat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:comment>Вимкнення або неправильна робота фільтрів, що призводить до постачання неочищеної води.
Маніпуляція з хімічними реагентами (наприклад, додавання надмірної кількості хлору).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnLightingSystem -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnLightingSystem">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_LPI"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#TechnogenicThreat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:comment>Вимкнення систем освітлення, що призводить до аварій або небезпечних умов праці</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnMaintenanceZone -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnMaintenanceZone">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_LPI"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#TechnogenicThreat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:comment>Атака на системм діагностики обладнання, що призводить до невиявлених поломок.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnPipelineNetwork -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnPipelineNetwork">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_WI"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#TechnogenicThreat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:comment>o	Вимкнення систем моніторингу тиску в трубопроводах, що призводить до витоків.
o	Фізичне пошкодження трубопроводів через кіберзагрози (наприклад, вимкнення систем захисту від корозії).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnPortCrane -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnPortCrane">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_LPI"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#TechnogenicThreat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:comment>така на системи керування кранами, що призводить до аварій або пошкодження вантажів та зупинки роботи обладнання</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnPumpStation -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnPumpStation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_WI"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#TechnogenicThreat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:comment>Вимкнення або перевантаження насосів через кібератаки, що призводить до зупинки водопостачання.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnSecuritySystem -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnSecuritySystem">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_LPI"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#TechnogenicThreat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:comment>Вимкнення систем відеоспостереження або контролю доступу</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnShipSanitization -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnShipSanitization">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_LPI"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#TechnogenicThreat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:comment>Вимкнення систем санітарної обробки суден, що призводить до поширення хвороб</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnWaterStorage -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnWaterStorage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_WI"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#TechnogenicThreat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:comment>Маніпуляція з рівнем води в резервуарах (наприклад, переповнення або зливання).
Пошкодження систем контролю якості води в резервуарах
Забруднення джерел води (&lt;WaterSource&gt;) хімічними або біологічними речовинами</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnWaterTreatmentPlant -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#AttackOnWaterTreatmentPlant">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_WI"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#TechnogenicThreat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:comment>На системи керування, що призводить до випуску небезпечної для здоров’я води.
Атаки на системи енергопостачання заводу</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_On_Gen -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_On_Gen">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_PG"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#TechnogenicThreat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:comment>Аеака на  генератор</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_LPI -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_LPI">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#TechnogenicThreat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>Атакі на портову структуру</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_PG -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_PG">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#TechnogenicThreat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>Атакі на структуру PowerGrid

Старіння трансформаторів та виснаження резервів надійності, що призводять до перебоїв у електропостачання</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_PLine -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_PLine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_PG"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#TechnogenicThreat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:comment>Атака на ліній передач</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_PSub -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_PSub">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_PG"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#TechnogenicThreat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:comment>Атака на силові підсстаці\</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_PTrans -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_PTrans">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_PG"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#TechnogenicThreat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:comment>Атака на  трансформатор</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_WI -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Attack_on_WI">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#TechnogenicThreat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>Техногенна Атака на КІ водопостачання</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#BilingOutageEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#BilingOutageEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ControlLossEvent"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>&lt;BilingOutageEvent&gt; (подія відключення білінгових систем) — це категорія ризиків, яка описує ситуації, коли системи обліку, тарифікації та виставлення рахунків у критичній інфраструктурі стають недоступними. Такі події особливо небезпечні для телекомунікацій, енергетики та фінансових секторів, адже вони напряму впливають на взаєморозрахунки, довіру клієнтів та стабільність бізнес-процесів.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#BillingFailure -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#BillingFailure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_CE"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_on_CloudX"/>
        <rdfs:comment>Без обліку — немає грошей → немає ремонтів → деградація CI
Затримка платежів → брак обігових коштів → неможливість купити паливо для ДГУ
Відмова білінгу = масові неплатежі → ланцюгова реакція банкрутства
Без актуальних договорів — неможливо законно відключити/відключити
Помилка в тарифах = мільйонні збитки або соціальні протести
Неточний прогноз = неможливість балансуванняі → віялові відключення
Відмова = хаос у відключеннях → соціальна напруга</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#BillingServices -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#BillingServices">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Cloud_ServicesX"/>
        <rdfs:comment>платіжна та розрахункова система для підтримки КІ

У сучасних умовах BillingSystem — це вже не просто «рахунки», а критична кібер-фізична платформа, відмова якої викликає каскадні ефекти.
Без обліку — немає грошей → немає ремонтів → деградація  мережі КІ
Комерційний облік споживання
Формування та доставка рахунків
Онлайн-оплата та інтеграція з платіжними системами
Управління договорами та CRM-функціонал
Тарифна політика та гнучкі тарифи
Прогнозування споживання та доходів (AI/ML)
Управління заборгованістю та відключеннями
Інтеграція з державними реєстрами
Аналітика та BI-дашборди
Архівування та юридична значущість даних</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Blackout_PG -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Blackout_PG">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Functional_Impact"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_CE"/>
        <rdfs:comment>Зупинка подачи електроживлення</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CI -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CI">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGenerator"/>
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
        <rdfs:comment>Критичні інфраструктури урбанистичного регіону</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CascadeEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CascadeEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>це подія, яка виникає внаслідок попередньої відмови, пошкодження або порушення функціонування одного чи кількох об’єктів критичної інфраструктури та спричиняє подальше поширення негативних наслідків на залежні компоненти або інші інфраструктурні системи</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CloudServiceOutage -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CloudServiceOutage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Functional_Impact"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_CE"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Cloud_Failure_Event -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Cloud_Failure_Event">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ControlLossEvent"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>Відмова хмарних сервісів може паралізувати енергетику, фінанси, транспорт, логістику  та комунікації одночасно.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Cloud_ServicesX -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Cloud_ServicesX">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CI"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
        <rdfs:comment>Cloud X (центр обробки даних), який надає послуги КІ урбаністичного регіону. Якість надання послуг Cloud X опосередковано впливає на функціонування інфраструктур урбаністичного регіону</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CombyThreat -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CombyThreat">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>комбінована загроза

Комбінація кількох загроз наприклад кібератака під час  дефіциту пального після фізичного пошкодження порту</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CommonCauseCasEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CommonCauseCasEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CascadeEvent"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>Подія загальної причини каскаду
На відміну від класичного послідовного каскаду («ефекту доміно», &lt;CommonCauseCasEvent&gt; породжує паралельні хвилі відмов через спільну вразливість або спільне джерело живлення/управління</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ContSysFailureEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ContSysFailureEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ControlLossEvent"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>Подія - відмова системи управління PG</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ContSysLPI -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ContSysLPI">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#LogisticsPort_Infrastructure"/>
        <rdfs:comment>центр управління інфраструктурою логістичного порту, адмініструє функціонування інфраструктурних об&apos;єктів та забезпечує моніторинг і координацію</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ContSysPG -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ContSysPG">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
        <rdfs:comment>контрольна система, яка адмініструє функціонування об&apos;єктів електричній мережі та забезпечує її моніторинг і координацію</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ContSysWI -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ContSysWI">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Water_Infrastructure"/>
        <rdfs:comment>контрольна система, що адмініструє об&apos;єкти водної інфраструктури та забезпечує її моніторинг і координацію</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ContainerTerminal -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ContainerTerminal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#LogisticsPort_Infrastructure"/>
        <rdfs:comment>контейнерний термінал</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ControlLossEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ControlLossEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>Подія втрати управління / Control Loss Event) описує критичну ситуацію в кіберфізичній системі, коли інфраструктурний об&apos;єкт або домен повністю чи частково втрачає дистанційне або автоматичне керування, диспетчерську видимість і здатність до адаптивного реагування.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CriticalFailureState -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CriticalFailureState">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WaterStorage"/>
        <rdfs:comment>Стан Критичний збій – повна зупинка роботи системи, що створює загрозу життю та безпеці населення

стан, за якого система, компонент або послуга повністю втратили свою цільову функціональність.
 На відміну від стану деградації, коли продуктивність знижена, але все ще працює, стан відмови сигналізує про повне збій, що часто викликає каскадні ефекти у взаємопов&apos;язаних системах</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CustomerServicePortal -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CustomerServicePortal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Cloud_ServicesX"/>
        <rdfs:comment>Портал для обслуговування користувачів
Функції:
Показання лічильників та самообслуговування
Онлайн-оплата рахунків та історія платежів
Заявки на технічні послуги та відстеження статусу
Особовий рахунок та історія нарахувань

не «додаток для скарг», а критичний інтерфейс взаємодії з клієнтами та державою.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Cyberattacks -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Cyberattacks">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>Спроби вивести з ладу системи SCADA та диспетчерські центри</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#DDoSAtack -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#DDoSAtack">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Cyberattacks"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#War_Strick"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#DamageEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#DamageEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>описує фізичне або функціональне пошкодження елементів критичної інфраструктури. На відміну від FunctionLossEvent, де йдеться про втрату функцій, DamageEvent фіксує сам факт руйнування чи деградації об’єкта, що може призвести до подальших каскадних наслідків 
Подія пошкодження характеризується типом і тяжкістю впливу, часом і місцем виникнення, ураженим активом, порушеною функцією, статусом відновлення та причинно-наслідковими зв’язками з іншими подіями. У мережі взаємопов’язаних КІ 
може бути як наслідком загрози, так і причиною подальших подій, що формують каскадний ефект</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#DataLeakage -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#DataLeakage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Cyberattacks"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>Витік даних відбувається, коли конфіденційна інформація ненавмисно розкривається неавторизованим сторонам. Наприклад, неправильно налаштований сервер хмарного сховища може забезпечити легкий доступ до персональної інформації (PII) та комерційної таємниці.)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#DegradedState -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#DegradedState">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#State_CI"/>
        <rdfs:comment>Стан деградації 
Зниження ефективності – система працює, але з обмеженнями (наприклад, зменшений тиск у водопроводі, часткове відключення електроенергії</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#DisruptedState -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#DisruptedState">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#State_CI"/>
        <rdfs:comment>Стан Порушене функціонування – суттєві перебої, що впливають на користувачів (наприклад, аварія трубопроводу, зупинка транспорту).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ERPSystem -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ERPSystem">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Cloud_ServicesX"/>
        <rdfs:comment>Системи планування ресурсів підприємства 

Управління матеріально-технічним постачанням (Procurement-to-Pay)
У сучасній практиці ERP вже давно вийшла за межі «бухгалтерії + кадрів» і стала критичною кібер-фізичною платформою управління ресурсами та ланцюгами постачання.
Функції:
Фінансове планування та бюджетування (FP&amp;A)
Управління персоналом і нарядами (HCM + Workforce Management)
Управління автотранспортом та спецтехнікою (Fleet Management)
Інтеграція з GIS і технічним паспортом мережі
Закупівля обладнання та комплектуючих</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ERP_Failure -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ERP_Failure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_CE"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_on_CloudX"/>
        <rdfs:comment>Відмова хмарної ERP = прямий каскадний ефект.
Планування та диспетчеризація ремонтних робіт (EAM / IBM Maximo модуль)
Управління контрактами та тендерами (ProZorro-інтеграція)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Economic_Impact -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Economic_Impact">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_CE"/>
        <rdfs:comment>дозволяє описати наслідки економічного впливу на стан взаємодіючих КІ</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#EscalatingCascadeEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#EscalatingCascadeEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CascadeEvent"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>ескалуюча каскадна подія) — це категорія ризиків, яка описує ситуації, коли початкова відмова або криза поступово наростає, охоплюючи нові інфраструктури та сфери.

 На відміну від CommonCauseCasEvent, де кілька систем страждають одночасно через одну причину, EscalatingCascadeEvent характеризується динамічним наростанням наслідків у часі та просторі.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment></rdfs:comment>
        <rdfs:comment>Подія змінює стан відповідного вузла, порушує його функціонування або створює умови для передачі відмови до залежних вузлів

є центральним вузлом онтології, оскільки вона пов&apos;язує причину (атаку) з наслідками (каскадними ефектами) та стосується будь-якого інциденту — природного, технічного або спричиненого людиною 
 перериває нормальне функціонування важливих систем і служб. Ці події можуть викликати каскадні ефекти у взаємопов&apos;язаних інфраструктурах, посилюючи їхній вплив</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event_SCADA_outage -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event_SCADA_outage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ControlLossEvent"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>SCADA система управління  не працює</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ExternalCustoms -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ExternalCustoms">
        <rdfs:comment>Зовнішні споживачи послуг  КІ</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Failed -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Failed">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#State_CI"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Failure_PumpEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Failure_PumpEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#FunctionLossEvent"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>подія Руйнування насосних стацій (мілітарі атак)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#FiltrSystem -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#FiltrSystem">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Water_Infrastructure"/>
        <rdfs:comment>Система фільтрації Видаляє забруднення води</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#FireFighting -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#FireFighting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#LogisticsPort_Infrastructure"/>
        <rdfs:comment>протипожежна портова система</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Fuel_Supply_Shortages -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Fuel_Supply_Shortages">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#FunctionLossEvent"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>Обмежені постачання вугілля/газу через блокади або пошкодження логістичних маршрутів</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#FunctionLossEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#FunctionLossEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>подія втрати функцій
Повна або часткова втрата функціональності компонента</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Functional_Impact -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Functional_Impact">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_CE"/>
        <rdfs:comment>дозволяє описати втрату інфраструктурної функціональності</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#GeneratorFailureEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#GeneratorFailureEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#FunctionLossEvent"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>подія відмова генератора</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#HealthImpact -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#HealthImpact">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#HumanSocial_Impact"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_CE"/>
        <rdfs:comment>Вплив на здоров’я – ризики для фізичного та психічного здоров’я (забруднена вода, відсутність медичних послуг</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Hospital -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Hospital">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ExternalCustoms"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#HumanSocial_Impact -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#HumanSocial_Impact">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_CE"/>
        <rdfs:comment>дозволяє описати як виникнення каскаду може впливати на соціальний стан суспільства, наприклад, пплив на здоров&apos;я, безпеку та добробут населення (наприклад, збої в роботі лікарень).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_CE -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_CE">
        <rdfs:comment>Вплив Клас, призначений для опису вимірюваних наслідків каскадного ефекту на КІ, послуги та суспільство. Це ключовий показник, який використовується для оцінки вразливості, визначення пріоритетів захисту та керівництва стратегіями стійкості. механізмів впливу на взаємодіючі КІ</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_on_CloudX -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_on_CloudX">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_CE"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#LPI_DisruptionEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#LPI_DisruptionEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#DamageEvent"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment></rdfs:comment>
        <rdfs:comment>Подія порушення роботи портової структури</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#LPI_cargo_delays -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#LPI_cargo_delays">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Functional_Impact"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_CE"/>
        <rdfs:comment>Затримки в грузових перевізках</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#LPI_power_outage -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#LPI_power_outage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerLossEvent"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#LightingSystem -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#LightingSystem">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#LogisticsPort_Infrastructure"/>
        <rdfs:comment>системи освітлення в порту</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#LogisticsPort_Infrastructure -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#LogisticsPort_Infrastructure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CI"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
        <rdfs:comment>інфраструктура логістичного порту, що отримує електроживлення і взаємодіє з системою водопостачання</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#MaintenanceZone -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#MaintenanceZone">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#LogisticsPort_Infrastructure"/>
        <rdfs:comment>зона технічного обслуговування в порту
Зона, що вимагає ресурсів для обслуговування.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#NaturalThreat -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#NaturalThreat">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>природна загроза
Сильні шторми або повені, що пошкоджують лінії електропередач</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Normal-OperatState -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Normal-OperatState">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#State_CI"/>
        <rdfs:comment>Нормальне функціонування – інфраструктура працює стабільно, без збоїв.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#OrganizationalThreat -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#OrganizationalThreat">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>Організаційна  загроза
Помилка оператора, недостатня координація, порушення регламенту, несвоєчасне реагування</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PipeLine -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PipeLine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Water_Infrastructure"/>
        <rdfs:comment>мережа магістральних та розподільчих трубопроводів
Доставка води споживачам</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PopulationAffected -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PopulationAffected">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#HumanSocial_Impact"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_CE"/>
        <rdfs:comment>Постраждале населення – кількість людей, які зазнали впливу (наприклад, без води, електрики чи транспорту)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PortClosure -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PortClosure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Functional_Impact"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_CE"/>
        <rdfs:comment>Зупинка роботи порту</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PortCrane -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PortCrane">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#LogisticsPort_Infrastructure"/>
        <rdfs:comment>портові крани</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PortalFailure -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PortalFailure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_CE"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_on_CloudX"/>
        <rdfs:comment>Відмова порталу = каскадний ефект соціально-економічних наслідків.
Помилки в обліку → масові перерахунки → соціальна напруга
Немає платежів → брак обігових коштів
Затримка заявок → зупинка нового приєднання та ремонтів</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGenerator -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGenerator">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CI"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CI"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGenerator"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Water_Infrastructure"/>
        <rdfs:comment>загальна електрична мережа, що інтегрує елементи генерації, розподілу та споживання енергії</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerLine -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerLine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#voltageLevel"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>лінія передач фізично передає електроенергію на відстані до підстанцій, промислових підприємств та споживачів</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerLineDisconnection -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerLineDisconnection">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerLossEvent"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>втрата можливості розподілу електроенергії через порушення ліній передач</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerLossEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerLossEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>Припинення електроживлення компонента

один із найкритичніших тригерів каскадних ефектів, адже електроенергія — базовий ресурс для всіх інших інфраструктур</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerSubstation -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerSubstation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
        <rdfs:comment>підстанція агрегує, розподіляє та перемикає енергію між мережами передачі та розподілу</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PumpStation -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PumpStation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Water_Infrastructure"/>
        <rdfs:comment>Насосна станція Забезпечує тиск і рух води</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Ransomware -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Ransomware">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Cyberattacks"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>вірус-вимагач шифрує файли жертви або блокує доступ, а потім вимагає викуп (для відновлення доступу</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#RecoveryState -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#RecoveryState">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#State_CI"/>
        <rdfs:comment>Відновлення – інфраструктура перебуває у процесі ремонту чи стабілізації після збою.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ResourceThreat -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ResourceThreat">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>загроза дефіциту ресурсів
Дефіцит пального, води, електроенергії, запасних частин, персоналу або каналів зв’язку</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#SCADAFailure -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#SCADAFailure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_CE"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_on_CloudX"/>
        <rdfs:comment></rdfs:comment>
        <rdfs:comment>Відмова хмарного сервісу SCADA призводить до критичного каскадного ефекту
Power Grid	
Втрата балансування напруги та частоти.
 Неможливість віддаленого перемикання ліній.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#SCADAServices -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#SCADAServices">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Cloud_ServicesX"/>
        <rdfs:comment>Управління та моніторинг

SCADA (Supervisory Control And Data Acquisition) — це програмно-апаратний комплекс для диспетчерського управління та збору даних, який дозволяє моніторити, керувати та автоматизувати технологічні процеси в реальному часі, збираючи дані з датчиків, візуалізуючи їх для оператора (через мнемосхеми, графіки), та даючи змогу віддалено керувати обладнанням

функції:
Моніторинг у реальному часі
Управління обладнанням
Аварійне реагування
Збір та збереження даних
Аналітика та прогнозування
Інтеграція з ERP/Billing
Безпека та кіберзахист</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#SecuritySystem -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#SecuritySystem">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#LogisticsPort_Infrastructure"/>
        <rdfs:comment>системи охорони порту</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ShipSanitization -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ShipSanitization">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#LogisticsPort_Infrastructure"/>
        <rdfs:comment>санітарна обробка суден</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ShipTracking -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ShipTracking">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#LogisticsPort_Infrastructure"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#SocialDisruption -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#SocialDisruption">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#HumanSocial_Impact"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_CE"/>
        <rdfs:comment>Соціальні порушення – 
Масові протести, паніка, зростання злочинності через дефіцит ресурсів.
Зниження довіри  
Втрата довіри до державних інституцій та критичних систем.
Психологічний вплив  
Стрес, тривожність, депресія серед населення через тривалі перебої.
Міждоменні наслідки  
Соціальні порушення можуть поширюватися на економіку, політику та безпеку</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#State_CI -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#State_CI">
        <rdfs:comment>Стан критичнії інфраструктури</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#SubsDistributionLossEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#SubsDistributionLossEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#FunctionLossEvent"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>втрата можливості розподілу електроенергії</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#TechnogenicThreat -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#TechnogenicThreat">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>Техногенні загрози 
категорія загроз  через технічні фактори, які можуть спричинити відмови технічного обладнання КІ, порушення його роботи та викликати  каскадні ефекти</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>потенційна загроза</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event">
        <rdfs:comment>Threat і Event розглядаються як взаємопов’язані, але не тотожні концепти.
 Threat описує потенційну загрозу або умову виникнення порушення, 
 Event фіксує подію, яка фактично відбулася або спостерігається в системі.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Transformer -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Transformer">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
        <rdfs:comment>трансформатор змінює рівні напруги для забезпечення ефективної передачі та розподілу електроенергії</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#TransformerFailureEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#TransformerFailureEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#FunctionLossEvent"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>Відмова трансформатора</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WI_pollutionEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WI_pollutionEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#DamageEvent"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>подія Забруднення водних джерел</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WI_power_outage -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WI_power_outage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerLossEvent"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>Відсутність енерго живлення системи водопостачання</rdfs:comment>
        <rdfs:comment>відключення живлення LPI</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WarStrickOnPG -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WarStrickOnPG">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#War_Strick"/>
        <rdfs:comment>Військовий удар по електромережі / War Strike on Power Grid) є екстремальною категорією тригерної події та кінетичної загрози. У контексті досліджень стійкості критичної інфраструктури та сценарного аналізу, такий клас моделює цілеспрямований силовий (фізичний) вплив на елементи домену &lt;PowerGrid&gt;, що слугує найпотужнішим початковим імпульсом для масштабних каскадних процесів.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WarStrickOnPLI -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WarStrickOnPLI">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#War_Strick"/>
        <rdfs:comment>це підклас воєнних фізичних загроз, що репрезентує навмисний удар по об’єктах портово-логістичної інфраструктури та може спричинити їхнє пошкодження, втрату функціональності, припинення портових операцій і поширення каскадних наслідків на енергетичну, водогосподарську та цифрову інфраструктури.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WarStrickOnWI -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WarStrickOnWI">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#War_Strick"/>
        <rdfs:comment>це підклас воєнних фізичних загроз, який репрезентує навмисний удар по об’єктах водної інфраструктури та може спричинити їхнє фізичне пошкодження, втрату функціональності, погіршення якості води, порушення водопостачання і формування каскадних ефектів у суміжних критичних інфраструктурах.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#War_Strick -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#War_Strick">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Theat"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>Військова атака 
Ракетні та безпілотні удари по підстанціях, розподільчих станціях та структурі систем</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WaterSource -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WaterSource">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Water_Infrastructure"/>
        <rdfs:comment>джерела води (річки, озера, підземні води)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WaterStorage -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WaterStorage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Water_Infrastructure"/>
        <rdfs:comment>Резервуари та вежі для зберігання очищеної води</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WaterSupplyLossEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WaterSupplyLossEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#DamageEvent"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>подія втрати водопостачання</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WaterTreatmentPlant -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WaterTreatmentPlant">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Water_Infrastructure"/>
        <rdfs:comment>завод для очищення та підготовки води</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Water_Infrastructure -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Water_Infrastructure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CI"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
        <rdfs:comment>Система очищення та постачання води, що включає системи водопостачання, які залежать від електропідживлення</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Water_Outage -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Water_Outage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Functional_Impact"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Impact_CE"/>
        <rdfs:comment>Відсутність водопостачання</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#feedback_loop_Event -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#feedback_loop_Event">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#CascadeEvent"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>подія яка утворює замкнений каскадний контур (feedback loop): відмова енергосистеми впливає на ІТ/SCADA, а деградація SCADA, у свою чергу, погіршує можливість керування енергосистемою.
Подія каскаду з петлею зворотного зв&apos;язку описує складні циркулярні (приховані) процеси у взаємопов&apos;язаних КІ, де збій у певному домені викликає ланцюжок наслідків у суміжних системах, який у результаті повертається та посилює початковий збій (циклічна або замкнена залежність). На відміну від лінійних чи ескалаційних каскадів, де рух іде в один бік (від тригера до колапсу), петля зворотного зв&apos;язку створює ефект самопідживлення аварії (наприклад, негативний зворотний зв&apos;язок, що руйнує стабільність КІ).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#pipeline_failureEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#pipeline_failureEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Event"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#FunctionLossEvent"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Threat_and_Event"/>
        <rdfs:comment>Аварія або пошкодження трубопроводу в результаті атаки</rdfs:comment>
    </owl:Class>
    


