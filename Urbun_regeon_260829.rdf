        <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#PowerGrid"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#WaterTreatmentPlant"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#Water_Infrastructure"/>
        <untitled-ontology-85:IsControlledBy rdf:resource="http://www.semanticweb.org/user/ontologies/2025/10/untitled-ontology-85#ControlWI"/>
